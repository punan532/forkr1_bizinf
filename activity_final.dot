digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить количество, цену и скидку (Scanner или строка CSV);\nставка НДС = VAT_RATE = 10 % (вариант 1)" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n0 [label="Разобрать значения: количество — int, цена и скидка — double;\nпустое или нечисловое значение -> ошибка формата"];
f0 [label="Формат корректен" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n2 [label="A1 validationError(): 1 <= количество <= 10 000;\n0 < цена <= 5 000 000; 0 <= скидка <= 30" ,fillcolor="#E2F0D9",color="#548235"];
n3 [label="Данные корректны" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n4 [label="calculateBase(): база = количество × цена" ];
n5 [label="A2 applyDiscount(): сумма со скидкой = база × (1 − скидка / 100);\ncalculateVat(): НДС = сумма со скидкой × 10 / 100;\nитог = сумма со скидкой + НДС, roundMoney() до копеек" ,fillcolor="#E2F0D9",color="#548235"];
n6 [label="Вывести базу, скидку, НДС и итог в рублях\nс двумя знаками после запятой" ];
n7 [label="Вывести понятную причину ошибки, расчёт не выполнять" ];
start -> n1; n1 -> n0; n0 -> f0; f0 -> n2 [label="да"]; f0 -> n7 [label="нет"];
n2 -> n3; n3 -> n4 [label="да"]; n3 -> n7 [label="нет"];
n4 -> n5; n5 -> n6; n6 -> end; n7 -> end;
}
